
---
import {
  Newspaper,
  Candy,
  CupSoda,
  Cigarette,
  CreditCard,
} from "@lucide/astro";

const products = [
  {
    title: "Zeitungen & Zeitschriften",
    icon: Newspaper,
    image: "",
  },
  {
    title: "Süßwaren & Snacks",
    icon: Candy,
    image: "",
  },
  {
    title: "Getränke",
    icon: CupSoda,
    image: "",
  },
  {
    title: "Tabakwaren",
    icon: Cigarette,
    image: "",
  },
  {
    title: "Guthabenkarten",
    icon: CreditCard,
    image: "",
  },
];
---

<section
  id="sortiment"
  class="products-section"
  aria-labelledby="products-title"
>
  <div class="products-container">

    <div class="products-heading">
      <h2 id="products-title">
        Mehr als nur ein Paketshop
      </h2>

      <p>
        Neben Paketservices finden Sie bei uns
        auch eine große Auswahl an:
      </p>
    </div>

    <div class="products-grid">
      {products.map(({ title, icon: Icon, image }) => (
        <article class="product-card">

          {image ? (
            <img
              src={image}
              alt=""
              class="product-image"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="product-placeholder" aria-hidden="true">
              <Icon size={54} stroke-width={1.2} />
              <span>Foto folgt</span>
            </div>
          )}

          <div class="product-overlay">
            <Icon
              size={27}
              stroke-width={1.8}
              aria-hidden="true"
            />

            <h3>{title}</h3>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .products-section {
    position: relative;
    width: 100%;
    padding: 38px 24px 60px;
    background: #ffffff;
    scroll-margin-top: 6rem;
  }

  .products-container {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }

  /* Heading */

  .products-heading {
    max-width: 800px;
    margin: 0 auto 32px;
    text-align: center;
  }

  .products-heading h2 {
    margin: 0 0 12px;
    color: #14263d;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }

  .products-heading p {
    margin: 0;
    color: #566579;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.5;
  }

  /* Product cards */

  .products-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }

  .product-card {
    position: relative;
    aspect-ratio: 5 / 4;
    min-width: 0;
    overflow: hidden;
    border-radius: 15px;
    background: #33465b;
    isolation: isolate;

    box-shadow: 0 4px 12px rgba(20, 38, 61, 0.08);

    transition:
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(20, 38, 61, 0.18);
  }

  /* Images */

  .product-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.06);
  }

  /* Temporary image backgrounds */

  .product-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;

    color: rgba(255, 255, 255, 0.65);
    background:
      radial-gradient(
        circle at 70% 20%,
        rgba(255, 255, 255, 0.16),
        transparent 60%
      ),
      #34495e;
  }

  .product-card:nth-child(2) .product-placeholder {
    background-color: #60483f;
  }

  .product-card:nth-child(3) .product-placeholder {
    background-color: #34596a;
  }

  .product-card:nth-child(4) .product-placeholder {
    background-color: #465061;
  }

  .product-card:nth-child(5) .product-placeholder {
    background-color: #47566d;
  }

  .product-placeholder span {
    font-size: 0.8rem;
  }

  /* Dark gradient over bottom of photos */

  .product-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;

    background: linear-gradient(
      to top,
      rgba(5, 13, 22, 0.92) 0%,
      rgba(5, 13, 22, 0.5) 30%,
      transparent 75%
    );
  }

  /* Category labels */

  .product-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;

    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 16px;

    color: #ffffff;
  }

  .product-overlay svg {
    flex-shrink: 0;
    color: #ffffff;
  }

  .product-overlay h3 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(0.85rem, 1.15vw, 1.1rem);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* Tablet */

  @media (max-width: 1050px) {
    .products-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .product-overlay h3 {
      font-size: 1rem;
    }
  }

  /* Mobile */

  @media (max-width: 600px) {
    .products-section {
      padding: 34px 16px 44px;
    }

    .products-heading {
      margin-bottom: 24px;
    }

    .products-heading h2 {
      font-size: clamp(1.8rem, 7vw, 2.4rem);
    }

    .products-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .product-card {
      aspect-ratio: 4 / 5;
      border-radius: 12px;
    }

    .product-overlay {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 14px 12px;
    }

    .product-overlay h3 {
      font-size: 0.9rem;
    }

    .product-overlay svg {
      width: 24px;
      height: 24px;
    }

    .product-card:last-child {
      grid-column: span 2;
      aspect-ratio: 2 / 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-image {
      transition: none;
    }
  }
</style>

